# Copie para .env para desenvolvimento local (o .env nao vai para o Git).
# Em producao (Render) defina as variaveis no painel; nao use .env.

DJANGO_DEBUG=True
DJANGO_SECRET_KEY=troque-esta-chave-em-producao
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# DJANGO_CSRF_TRUSTED_ORIGINS=https://seu-dominio.com

# Banco: DATABASE_URL tem prioridade sobre as variaveis POSTGRES_*.
# DATABASE_URL=postgresql://usuario:senha@host:5432/banco
POSTGRES_DB=planejamento_pcc
POSTGRES_USER=planejamento_pcc
POSTGRES_PASSWORD=planejamento_pcc
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_CONN_MAX_AGE=60
POSTGRES_CONNECT_TIMEOUT=10

# SQLite apenas para desenvolvimento local (exige DJANGO_DEBUG=True)
# DJANGO_USE_SQLITE=True

# Uploads persistentes em bucket compativel com S3 (opcional)
# AWS_STORAGE_BUCKET_NAME=
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_S3_ENDPOINT_URL=
# AWS_S3_REGION_NAME=
